# All variables are optional. Defaults shown.
# Directory where artifacts are written. Must be writable. Relative paths resolve against the process cwd.
D3MCP_ARTIFACT_DIR=./artifacts
# Maximum number of records accepted per dataset.
D3MCP_MAX_ROWS=50000
# Maximum size (bytes) of inline payloads (text, base64 file contents, records).
D3MCP_MAX_INPUT_BYTES=10000000
# Directories the server may read data files from (':' separated; ';' on Windows). Empty = file input disabled.
D3MCP_DATA_DIRS=
# Maximum size (bytes) of a data file read from D3MCP_DATA_DIRS.
D3MCP_MAX_FILE_BYTES=25000000
# Artifact time-to-live in hours (expired artifacts are deleted on startup and periodically).
D3MCP_ARTIFACT_TTL_HOURS=72
# Browser operations (PNG/PDF export, browser validation) timeout in milliseconds.
D3MCP_BROWSER_TIMEOUT_MS=30000
# Render worker threads (default: CPUs - 1, max 4). 0 renders on the main thread.
D3MCP_RENDER_WORKERS=3
# Renders exceeding this are terminated and reported as LIMIT_EXCEEDED.
D3MCP_RENDER_TIMEOUT_MS=60000
# Transport: stdio (default) or http. Equivalent to the --http flag.
D3MCP_TRANSPORT=stdio
# HTTP transport. A non-loopback host requires D3MCP_HTTP_TOKEN.
D3MCP_HTTP_HOST=127.0.0.1
D3MCP_HTTP_PORT=3333
D3MCP_HTTP_TOKEN=
D3MCP_HTTP_ALLOWED_ORIGINS=
# Log level written to stderr: error | warn | info | debug
D3MCP_LOG_LEVEL=info
