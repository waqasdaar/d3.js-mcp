{
  "name": "d3-visualization-mcp",
  "version": "0.1.0",
  "description": "Universal D3 Visualization MCP Server: create, inspect, render, validate and export D3.js visualizations through the Model Context Protocol.",
  "type": "module",
  "license": "MIT",
  "main": "dist/server/index.js",
  "bin": {
    "d3-visualization-mcp": "dist/server/index.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "data",
    "schemas",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/server/index.js",
    "start:http": "node dist/server/index.js --http",
    "dev": "tsx src/server/index.ts",
    "test": "npm run test:unit && npm run test:integration && npm run test:browser",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.ts",
    "test:browser": "npm run build && playwright test",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "workbench:dev": "vite --config workbench/vite.config.ts",
    "workbench:build": "vite build --config workbench/vite.config.ts",
    "schema:generate": "tsx scripts/generate-schema.ts",
    "audit:d3": "tsx scripts/audit-d3-api.ts",
    "audit:d3:check": "tsx scripts/audit-d3-api.ts --check",
    "coverage:report": "tsx scripts/coverage-report.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "examples": "npm run build && tsx scripts/generate-examples.ts",
    "smoke": "npm run build && tsx scripts/smoke.ts",
    "verify:install": "tsx scripts/verify-install.ts",
    "report": "tsx scripts/generate-report.ts",
    "verify": "tsx scripts/verify.ts",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "d3": "7.9.0",
    "d3-sankey": "0.12.3",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "topojson-client": "3.1.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/d3": "7.4.3",
    "@types/d3-sankey": "0.12.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
